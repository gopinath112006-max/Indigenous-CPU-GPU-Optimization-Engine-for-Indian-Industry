@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)

if(HYPERNOVA_ENABLE_CUDA)
    find_dependency(CUDA REQUIRED)
endif()

if(HYPERNOVA_ENABLE_HIP)
    find_dependency(HIP REQUIRED)
endif()

if(HYPERNOVA_ENABLE_SYCL)
    find_dependency(SYCL REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HyperNovaTargets.cmake")

set(HYPERNOVA_INCLUDE_DIRS "@PACKAGE_PREFIX_DIR@/include")
set(HYPERNOVA_LIBRARIES hypernova_core hypernova_lp hypernova_milp hypernova_qp hypernova_numerical hypernova_execution hypernova_validation)